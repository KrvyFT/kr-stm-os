#!/usr/bin/env python3
"""Pack explicitly ordered ARM ELF executables into a KAPP v1 image."""

import argparse
import os
from pathlib import Path
import re
import struct
import tempfile
from typing import NamedTuple
import zlib


APP_START = 0x24060000
APP_END = 0x2407F000  # The remaining 4 KiB is the user stack.
MAX_IMAGE_BYTES = 8 * 1024 * 1024
MAX_APPS = 16
MAX_SEGMENTS = 16

ELF_HEADER = struct.Struct("<16sHHIIIIIHHHHHH")
PROGRAM_HEADER = struct.Struct("<8I")
PT_LOAD = 1
PF_X = 1

IMAGE_HEADER = struct.Struct("<4s5I")
APP_RECORD = struct.Struct("<16s3I")
SEGMENT_RECORD = struct.Struct("<5I")


class Segment(NamedTuple):
    address: int
    payload: bytes
    memory_size: int
    flags: int


class App(NamedTuple):
    name: bytes
    entry: int
    segments: list[Segment]


def parse_elf(elf):
    if len(elf) < ELF_HEADER.size:
        raise ValueError("truncated ELF header")
    (ident, kind, machine, version, entry, phoff, _, _, ehsize,
     phentsize, phnum, _, _, _) = ELF_HEADER.unpack_from(elf)
    if ident[:7] != b"\x7fELF\x01\x01\x01" or (kind, machine, version) != (2, 40, 1):
        raise ValueError("expected a little-endian ARM ELF32 executable")
    if (ehsize != ELF_HEADER.size or phentsize != PROGRAM_HEADER.size
            or phoff < ehsize or phoff + phentsize * phnum > len(elf)):
        raise ValueError("invalid ELF program header table")

    segments = []
    for index in range(phnum):
        offset = phoff + index * phentsize
        kind, start, address, _, file_size, mem_size, flags, _ = PROGRAM_HEADER.unpack_from(elf, offset)
        if kind != PT_LOAD:
            continue
        if file_size > mem_size or (file_size and start + file_size > len(elf)):
            raise ValueError(f"PT_LOAD {index}: invalid file size or offset")
        if not mem_size:
            continue
        end = address + mem_size
        if not (APP_START <= address < end <= APP_END):
            raise ValueError(f"PT_LOAD {index}: address range outside application SRAM")
        if any(address < segment.address + segment.memory_size and segment.address < end
               for segment in segments):
            raise ValueError(f"PT_LOAD {index}: overlaps another load segment")
        if len(segments) == MAX_SEGMENTS:
            raise ValueError(f"at most {MAX_SEGMENTS} load segments per application")
        # The kernel zeroes the memory beyond the file bytes, including .bss.
        segments.append(Segment(address, elf[start:start + file_size], mem_size, flags))

    address = entry & ~1
    if not (entry & 1) or not any(
        segment.flags & PF_X and segment.address <= address < segment.address + len(segment.payload)
        for segment in segments
    ):
        raise ValueError("entry must be a Thumb address in initialized executable data")
    return entry, segments


def load_apps(paths):
    if len(paths) > MAX_APPS:
        raise ValueError(f"at most {MAX_APPS} applications per image")
    apps = []
    names = set()
    for path in paths:
        name = path.stem if path.suffix == ".elf" else path.name
        if not re.fullmatch(r"[a-zA-Z0-9_.-]{1,16}", name):
            raise ValueError(f"{path}: expected a 1–16 byte ASCII application name (letters, digits, _, . or -)")
        if name in names:
            raise ValueError(f"{path}: duplicate application name {name!r}")
        try:
            entry, segments = parse_elf(path.read_bytes())
        except (OSError, ValueError) as error:
            raise ValueError(f"{path}: {error}") from error
        names.add(name)
        apps.append(App(name.encode("ascii"), entry, segments))
    return apps


def pack_image(apps):
    app_table_offset = IMAGE_HEADER.size
    segment_table_offset = app_table_offset + len(apps) * APP_RECORD.size
    payload_offset = segment_table_offset + sum(len(app.segments) for app in apps) * SEGMENT_RECORD.size
    total_size = payload_offset + sum(len(segment.payload) for app in apps for segment in app.segments)
    if total_size > MAX_IMAGE_BYTES:
        raise ValueError("image exceeds the 8 MiB QSPI flash capacity")

    image = bytearray(total_size)
    IMAGE_HEADER.pack_into(image, 0, b"KAPP", 1, total_size, len(apps), app_table_offset, 0)
    for index, app in enumerate(apps):
        app_offset = app_table_offset + index * APP_RECORD.size
        APP_RECORD.pack_into(image, app_offset, app.name, app.entry, len(app.segments), segment_table_offset)
        for segment in app.segments:
            SEGMENT_RECORD.pack_into(image, segment_table_offset, segment.address, payload_offset,
                                     len(segment.payload), segment.memory_size, segment.flags)
            segment_table_offset += SEGMENT_RECORD.size
            payload_end = payload_offset + len(segment.payload)
            image[payload_offset:payload_end] = segment.payload
            payload_offset = payload_end

    # Calculate CRC across the whole image with the CRC field still zero.
    struct.pack_into("<I", image, IMAGE_HEADER.size - 4, zlib.crc32(image))
    return image


def write_image(output, image):
    output.parent.mkdir(parents=True, exist_ok=True)
    temp = tempfile.NamedTemporaryFile(dir=output.parent, prefix=".pack-apps-", delete=False)
    temp_path = Path(temp.name)
    try:
        with temp:
            temp.write(image)
        os.replace(temp_path, output)
    finally:
        temp_path.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("-o", "--output", type=Path, required=True, help="image output path")
    parser.add_argument("elfs", nargs="*", type=Path, help="application ELFs in boot order")
    args = parser.parse_args()
    try:
        if any(path.resolve() == args.output.resolve() for path in args.elfs):
            raise ValueError("output must not overwrite an input ELF")
        apps = load_apps(args.elfs)
        image = pack_image(apps)
        write_image(args.output, image)
    except (OSError, ValueError) as error:
        parser.exit(1, f"{parser.prog}: {error}\n")
    print(f"{args.output}: {len(apps)} application(s), {len(image)} bytes")


if __name__ == "__main__":
    main()
