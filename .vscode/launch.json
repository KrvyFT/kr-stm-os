{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32H743VGT6",
      "type": "probe-rs-debug",
      "request": "launch",
      "preLaunchTask": "Build kr-stm-os",
      "chip": "STM32H743VGTx",
      "wireProtocol": "Swd",
      "flashingConfig": {
        "flashingEnabled": true,
        "haltAfterReset": false
      },
      "coreConfigs": [
        {
          "coreIndex": 0,
          "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/kr-stm-os",
          "svdFile": "${workspaceFolder}/svd/STM32H743.svd"
        }
      ]
    }
  ]
}
